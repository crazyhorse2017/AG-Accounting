{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ag-accounting",
  "compatibility_date": "2026-01-01",
  "main": "./src/worker/index.ts",
  // Custom domain goes here once AG Accounting's domain is known, e.g.
  // "routes": [{ "pattern": "example.com", "custom_domain": true }],
  "assets": {
    // Only the Vite build output is public. If the build didn't run, deploy fails
    // instead of publishing the raw source folder.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ag-accounting-db",
      "database_id": "e5a85942-6b6f-461b-976c-dff9a2257a83",
      "migrations_dir": "migrations"
    }
  ],
  // "0 8 * * *": daily cleanup of old contact messages and rate-limit keys.
  // "0 14 * * 2": Tuesdays 14:00 UTC (9 or 10 AM in Ohio): weekly tip, plus the monthly
  // newsletter in the first week of each month. Draft-only unless SEND_MODE is "auto".
  "triggers": {
    "crons": ["0 8 * * *", "0 14 * * 2"]
  }
}
